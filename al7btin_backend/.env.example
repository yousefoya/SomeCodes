# ==============================================
# 1. SERVER CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1

# ==============================================
# 2. DATABASE CONFIGURATION (PostgreSQL + Drizzle)
# ==============================================
DATABASE_URL=postgresql://btin7al_user:btin7al_secure_pass@localhost:5432/btin7al_db?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==============================================
# 3. AUTHENTICATION & SECURITY (JWT & OTP)
# ==============================================
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_64_characters_long_random_hex
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_64_characters_long_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ==============================================
# 4. CORS CONFIGURATION
# ==============================================
CORS_ORIGIN=*
